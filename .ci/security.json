{
  "schema": 1,
  "threshold": "high",
  "max_age_hours": 24,
  "scans": [
    {
      "id": "secrets",
      "format": "gitleaks",
      "command": [
        "gitleaks",
        "dir",
        ".",
        "--redact=100",
        "--report-format",
        "json",
        "--report-path",
        "{report}",
        "--no-banner"
      ],
      "version_command": [
        "gitleaks",
        "version"
      ],
      "version": "8.30.1",
      "output": "file",
      "rules_identity": "builtin:8.30.1",
      "database_identity": "none",
      "allowed_exit_codes": [
        0,
        1
      ]
    }
  ]
}
