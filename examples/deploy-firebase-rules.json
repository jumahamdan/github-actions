{
  "schema": 1,
  "provider": "firebase",
  "operation": "deploy",
  "environment": "staging",
  "allowed_refs": [
    "refs/heads/staging"
  ],
  "inputs": [
    "firebase.json",
    "firestore.rules",
    "storage.rules"
  ],
  "tools": {
    "firebase": {
      "command": [
        "firebase"
      ],
      "version": "14.10.1"
    },
    "gcloud": {
      "command": [
        "gcloud"
      ],
      "version": "582.0.0"
    }
  },
  "settings": {
    "project": "example-staging",
    "config": "firebase.json",
    "components": [
      "firestore:rules",
      "storage"
    ],
    "rule_files": {
      "cloud.firestore": "firestore.rules",
      "firebase.storage/example-staging.firebasestorage.app": "storage.rules"
    }
  },
  "receipt": ".ci-results/deployment.json",
  "timeout": 1800
}
