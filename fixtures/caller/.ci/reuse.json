{
  "schema": 1,
  "quality_config": ".ci/quality.json",
  "max_age_seconds": 86400,
  "source": {
    "repository": "jumahamdan/shared-workflow-contract-fixture",
    "workflow": ".github/workflows/contract.yml",
    "run_id": {"env": "QUALITY_RUN_ID"},
    "run_head_sha": {"env": "QUALITY_RUN_HEAD_SHA"},
    "source_sha": {"env": "QUALITY_TESTED_SHA"},
    "run_attempt": {"env": "QUALITY_RUN_ATTEMPT"},
    "artifact": {"env": "QUALITY_ARTIFACT"},
    "producer_job": {"env": "QUALITY_PRODUCER_JOB"},
    "allowed_branches": {"env": "QUALITY_ALLOWED_BRANCHES"},
    "allowed_events": {"env": "QUALITY_ALLOWED_EVENTS"}
  }
}
